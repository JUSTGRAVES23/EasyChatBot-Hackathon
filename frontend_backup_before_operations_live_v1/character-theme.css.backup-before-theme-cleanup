/* EasyChatBot Character Theme Layer
   Loaded after style.css.
   Character palettes remain backend-controlled. */

:root {
    --ecb-character-primary: #2563eb;
    --ecb-character-secondary: #123b8a;
    --ecb-character-accent: #16a34a;
    --ecb-character-background: #eef4ff;
    --ecb-character-surface: #ffffff;
    --ecb-character-surface-alt: #f8fafc;
    --ecb-character-text-primary: #172033;
    --ecb-character-text-secondary: #64748b;
    --ecb-character-highlight: #eff6ff;
    --ecb-character-atmosphere: transparent;
    --ecb-theme-transition: 280ms ease;
}

body,
.brand-badge,
header h1,
.character,
#characters button,
.notification,
.notification-icon,
.notification-label,
.notification-action,
.eyebrow,
.character-badge,
.product-card,
.product-image,
.price,
.discount,
.relevance-list span,
.primary-action,
.secondary-action,
.chat,
.chat-button,
pre {
    transition:
        background var(--ecb-theme-transition),
        background-color var(--ecb-theme-transition),
        border-color var(--ecb-theme-transition),
        color var(--ecb-theme-transition),
        box-shadow var(--ecb-theme-transition);
}

body {
    background:
        radial-gradient(
            circle at 90% 5%,
            color-mix(in srgb, var(--ecb-character-secondary) 14%, transparent),
            transparent 34%
        ),
        linear-gradient(
            135deg,
            var(--ecb-character-background),
            var(--ecb-character-surface-alt)
        );
    color: var(--ecb-character-text-primary);
}

.brand-badge { background: var(--ecb-character-secondary); }
header h1 { color: var(--ecb-character-secondary); }
header p { color: var(--ecb-character-text-secondary); }

.character {
    background: var(--ecb-character-surface);
    box-shadow:
        0 10px 30px
        color-mix(in srgb, var(--ecb-character-secondary) 10%, transparent);
}

#characters button { background: var(--ecb-character-primary); }
#characters button:hover { background: var(--ecb-character-secondary); }
#selected-character { color: var(--ecb-character-text-secondary); }

.notification {
    background: var(--ecb-character-highlight);
    border-color:
        color-mix(in srgb, var(--ecb-character-primary) 30%, transparent);
}

.notification-icon {
    background: var(--ecb-character-surface);
    color: var(--ecb-character-primary);
}

.notification-label { color: var(--ecb-character-primary); }
.notification-content p { color: var(--ecb-character-text-secondary); }

.notification-action {
    background: var(--ecb-character-primary);
}

.notification-action:hover {
    background: var(--ecb-character-secondary);
}

.eyebrow { color: var(--ecb-character-primary); }
.character-badge { background: var(--ecb-character-secondary); }

.product-card {
    background: var(--ecb-character-surface);
    box-shadow:
        0 18px 45px
        color-mix(in srgb, var(--ecb-character-secondary) 12%, transparent);
}

.product-image {
    background:
        linear-gradient(
            145deg,
            var(--ecb-character-highlight),
            var(--ecb-character-surface-alt)
        );
}

.price { color: var(--ecb-character-secondary); }

.discount {
    color: var(--ecb-character-secondary);
    background:
        color-mix(
            in srgb,
            var(--ecb-character-accent) 18%,
            var(--ecb-character-surface)
        );
}

.relevance-list span {
    background: var(--ecb-character-surface-alt);
    color: var(--ecb-character-text-primary);
}

.primary-action { background: var(--ecb-character-accent); }

.primary-action:hover { filter: brightness(0.94); }

.secondary-action {
    background: var(--ecb-character-highlight);
    color: var(--ecb-character-text-primary);
    border:
        1px solid
        color-mix(in srgb, var(--ecb-character-primary) 18%, transparent);
}

.chat {
    background: var(--ecb-character-surface);
    box-shadow:
        0 10px 30px
        color-mix(in srgb, var(--ecb-character-secondary) 10%, transparent);
}

textarea {
    border-color:
        color-mix(in srgb, var(--ecb-character-primary) 25%, #cbd5e1);
    color: var(--ecb-character-text-primary);
}

textarea:focus {
    outline:
        2px solid
        color-mix(in srgb, var(--ecb-character-primary) 28%, transparent);
    border-color: var(--ecb-character-primary);
}

.chat-button { background: var(--ecb-character-primary); }
.chat-button:hover { background: var(--ecb-character-secondary); }

pre {
    background: var(--ecb-character-surface-alt);
    color: var(--ecb-character-text-primary);
}

html[data-character] {
    --ecb-theme-character-active: 1;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    opacity: 0.16;
    background: var(--ecb-character-atmosphere);
}

@media (prefers-reduced-motion: reduce) {
    body,
    .brand-badge,
    header h1,
    .character,
    #characters button,
    .notification,
    .notification-icon,
    .notification-label,
    .notification-action,
    .eyebrow,
    .character-badge,
    .product-card,
    .product-image,
    .price,
    .discount,
    .relevance-list span,
    .primary-action,
    .secondary-action,
    .chat,
    .chat-button,
    pre {
        transition: none;
    }
}
