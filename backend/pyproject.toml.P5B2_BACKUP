[build-system]
requires = [
    "setuptools>=68",
    "wheel",
]
build-backend = "setuptools.build_meta"


[project]
name = "easychatbot-backend"
version = "0.1.0"
description = "EasyChatBot backend runtime"
requires-python = ">=3.13"

dependencies = [
    "pyyaml",
    "fastapi",
    "uvicorn",
    "resend>=2.39,<3",
    "psycopg2-binary>=2.9,<3",
    "apscheduler>=3.10,<4",
    "email-validator>=2.0,<3",
    "livekit-api>=1,<2",
    "livekit-agents>=1,<2",
]


[tool.setuptools]
packages = [
    "src",
    "src.ai_runtime",
    "src.ai_runtime.providers",
    "src.ai_runtime.providers.usage",

    "app",
    "app.domain",
    "app.domain.uai",
    "app.domain.uai.context",

    "app.application",
    "app.application.academy",
    "app.application.identity",
    "app.application.uai",
    "app.application.uai.world",
    "app.application.provider_management",
    "app.application.operations_center",

    "app.infrastructure",
    "app.infrastructure.worlds",

    "app.configuration",
    "app.configuration.worlds",

    "app.interfaces",
    "app.interfaces.provider_management",
]


[tool.setuptools.package-dir]
"" = "."
"src" = "../src"


[project.optional-dependencies]
test = [
    "pytest",
    "pytest-asyncio",
]


[tool.pytest.ini_options]
pythonpath = [
    "..",
]