from app.application.payment.guardian_registration import (
    AgePolicyClassification,
    evaluate_guardian_registration_requirement,
)


def test_under_15_requires_guardian_email():
    result = evaluate_guardian_registration_requirement(
        AgePolicyClassification.UNDER_15,
    )

    assert result.required is True
    assert result.guardian_email is None


def test_under_15_accepts_guardian_email():
    result = evaluate_guardian_registration_requirement(
        AgePolicyClassification.UNDER_15,
        " Parent@Example.COM ",
    )

    assert result.required is True
    assert result.guardian_email == "parent@example.com"


def test_adult_does_not_require_guardian_email():
    result = evaluate_guardian_registration_requirement(
        AgePolicyClassification.ADULT,
    )

    assert result.required is False
    assert result.guardian_email is None


def test_student_does_not_automatically_require_guardian_email():
    result = evaluate_guardian_registration_requirement(
        AgePolicyClassification.STUDENT,
    )

    assert result.required is False


def test_15_to_17_does_not_automatically_require_guardian_email():
    result = evaluate_guardian_registration_requirement(
        AgePolicyClassification.AGE_15_TO_17,
    )

    assert result.required is False
