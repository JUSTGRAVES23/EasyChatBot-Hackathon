from __future__ import annotations

from typing import Any

from backend.runtime.external_runtime_container import ExternalRuntimeContainer


class RuntimeApplicationService:
    """Application service translating application requests to runtime calls."""

    def __init__(self, container: ExternalRuntimeContainer) -> None:
        self._container = container

    async def execute(
        self,
        *,
        capability: str,
        payload: dict[str, Any],
    ) -> Any:
        if not isinstance(capability, str) or not capability.strip():
            raise ValueError("capability must be a non-empty string")

        request = {
            "capability": capability,
            "payload": payload,
        }
        return await self._container.gateway.execute(request)
