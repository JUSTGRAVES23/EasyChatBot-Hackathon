from __future__ import annotations

from typing import Any

from backend.runtime.external_runtime_container import ExternalRuntimeContainer


class ExternalRuntimeService:
    """Application-facing boundary for governed runtime execution."""

    def __init__(self, container: ExternalRuntimeContainer) -> None:
        self._container = container

    async def execute(self, request: Any) -> Any:
        return await self._container.gateway.execute(request)
