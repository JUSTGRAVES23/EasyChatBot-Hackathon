from __future__ import annotations

from typing import Any

from backend.runtime.external_runtime_container import ExternalRuntimeContainer
from backend.services.external_runtime_service import ExternalRuntimeService


class ApplicationFactory:
    """Application composition root for the external runtime boundary."""

    @staticmethod
    def create(
        *,
        config: Any,
        runtime_container: ExternalRuntimeContainer | None = None,
    ) -> ExternalRuntimeService:
        container = runtime_container or ExternalRuntimeContainer.from_config(config)
        return ExternalRuntimeService(container)
