from __future__ import annotations

from dataclasses import dataclass
from enum import Enum


class AgePolicyClassification(str, Enum):
    ADULT = "adult"
    STUDENT = "student"
    UNDER_15 = "under_15"
    AGE_15_TO_17 = "age_15_to_17"


@dataclass(frozen=True)
class GuardianRegistrationRequirement:
    required: bool
    guardian_email: str | None = None


def evaluate_guardian_registration_requirement(
    classification: AgePolicyClassification,
    guardian_email: str | None = None,
) -> GuardianRegistrationRequirement:
    if classification == AgePolicyClassification.UNDER_15:
        if not guardian_email or not guardian_email.strip():
            return GuardianRegistrationRequirement(
                required=True,
                guardian_email=None,
            )

        return GuardianRegistrationRequirement(
            required=True,
            guardian_email=guardian_email.strip().lower(),
        )

    return GuardianRegistrationRequirement(
        required=False,
        guardian_email=None,
    )


__all__ = [
    "AgePolicyClassification",
    "GuardianRegistrationRequirement",
    "evaluate_guardian_registration_requirement",
]
