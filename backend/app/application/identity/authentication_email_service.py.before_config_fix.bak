from __future__ import annotations

from html import escape
from pathlib import Path
import os
from typing import Protocol


class AuthenticationEmailSender(Protocol):
    """Application boundary for authentication email delivery."""

    async def send(
        self,
        subject: str,
        content: dict,
    ) -> dict:
        ...


class AuthenticationEmailService:
    """Build and deliver branded EasyChatBot verification emails."""

    LOGO_CONTENT_ID = "easychatbot-logo"

    def __init__(
        self,
        email_sender: AuthenticationEmailSender,
        *,
        frontend_base_url: str,
        privacy_url: str,
        logo_path: str | Path | None = None,
    ) -> None:
        self._registration_sender = os.getenv(
            "EASYCHATBOT_REGISTRATION_EMAIL"
        )

        self._email_sender = email_sender
        self._frontend_base_url = frontend_base_url.rstrip("/")
        self._privacy_url = privacy_url

        if logo_path is None:
            logo_path = (
                Path(__file__).resolve().parents[2]
                / "assets"
                / "email"
                / "easychatbot-logo.png"
            )

        self._logo_path = Path(logo_path)

        if not self._logo_path.is_file():
            raise FileNotFoundError(
                f"EasyChatBot email logo not found: {self._logo_path}"
            )

    async def send_verification_email(
        self,
        *,
        email: str,
        username: str,
        verification_token: str,
    ) -> dict:
        recipient = email.strip()
        display_name = username.strip()

        verification_url = (
            f"{self._frontend_base_url}"
            f"/verify-email?token={verification_token}"
        )

        html = self._build_html(
            username=display_name,
            verification_url=verification_url,
        )

        text = self._build_text(
            username=display_name,
            verification_url=verification_url,
        )

        if not self._registration_sender:
            raise RuntimeError(
                "EASYCHATBOT_REGISTRATION_EMAIL is not configured."
            )

        return await self._email_sender.send(
            "🎓 Welcome to EasyChatBot, "
            f"@{display_name} — your journey starts here!",
            {
                "recipient": recipient,
                "email_type": "authentication_verification",
                "from": self._registration_sender,
                "username": display_name,
                "body": text,
                "html": html,
                "attachments": [
                    {
                        "path": str(self._logo_path),
                        "filename": "easychatbot-logo.png",
                        "inline": True,
                        "content_id": self.LOGO_CONTENT_ID,
                    }
                ],
            },
        )

    def _build_html(
        self,
        *,
        username: str,
        verification_url: str,
    ) -> str:
        safe_username = escape(username)
        safe_verification_url = escape(
            verification_url,
            quote=True,
        )
        safe_privacy_url = escape(
            self._privacy_url,
            quote=True,
        )

        return f"""<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title>Welcome to EasyChatBot</title>
</head>
<body
    style="
        margin:0;
        padding:0;
        background:#f6f7fb;
        font-family:Arial,Helvetica,sans-serif;
        color:#1f2937;
    "
>
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background:#f6f7fb;"
    >
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width:620px;
                        background:#ffffff;
                        border-radius:18px;
                        overflow:hidden;
                    "
                >
                    <tr>
                        <td
                            align="center"
                            style="padding:32px 28px 18px;"
                        >
                            <img
                                src="cid:{self.LOGO_CONTENT_ID}"
                                alt="EasyChatBot — Growing With You."
                                style="
                                    display:block;
                                    max-width:260px;
                                    width:100%;
                                    height:auto;
                                    border:0;
                                "
                            />
                        </td>
                    </tr>

                    <tr>
                        <td
                            align="center"
                            style="padding:16px 36px 8px;"
                        >
                            <div
                                style="
                                    font-size:28px;
                                    font-weight:700;
                                "
                            >
                                🎓 Welcome to EasyChatBot
                            </div>

                            <div
                                style="
                                    margin-top:10px;
                                    font-size:17px;
                                    color:#6b7280;
                                "
                            >
                                Your journey starts here.
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:28px 40px 10px;
                                font-size:16px;
                                line-height:1.7;
                            "
                        >
                            Hey {safe_username} 👋
                            <br><br>
                            Welcome to <strong>EasyChatBot!</strong>
                            <br><br>
                            You've just taken your first step into
                            your learning journey — and we're excited
                            to have you here.
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:12px 40px 22px;">
                            <table
                                role="presentation"
                                width="100%"
                                cellspacing="0"
                                cellpadding="0"
                                border="0"
                                style="
                                    background:#f4f7ff;
                                    border-radius:14px;
                                "
                            >
                                <tr>
                                    <td
                                        align="center"
                                        style="padding:24px 20px;"
                                    >
                                        <div
                                            style="
                                                font-size:13px;
                                                font-weight:700;
                                                text-transform:uppercase;
                                                letter-spacing:1px;
                                                color:#6b7280;
                                            "
                                        >
                                            Your EasyChatBot identity
                                        </div>

                                        <div
                                            style="
                                                margin-top:10px;
                                                font-size:25px;
                                                font-weight:700;
                                            "
                                        >
                                            @{safe_username}
                                        </div>

                                        <div
                                            style="
                                                margin-top:8px;
                                                font-size:14px;
                                                color:#6b7280;
                                            "
                                        >
                                            Your unique identity
                                            inside EasyChatBot.
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:4px 40px 10px;
                                font-size:16px;
                                line-height:1.7;
                            "
                        >
                            You can use your EasyChatBot alias to
                            connect with other learners, participate
                            in activities and identify yourself across
                            the platform.
                            <br><br>
                            Think of it as your name inside the
                            EasyChatBot community.
                        </td>
                    </tr>

                    <tr>
                        <td
                            align="center"
                            style="padding:24px 40px 10px;"
                        >
                            <div
                                style="
                                    font-size:21px;
                                    font-weight:700;
                                "
                            >
                                🔐 One last step
                            </div>

                            <div
                                style="
                                    margin-top:10px;
                                    font-size:15px;
                                    line-height:1.6;
                                    color:#6b7280;
                                "
                            >
                                Before you enter the Academy,
                                let's make sure this email address
                                really belongs to you.
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td
                            align="center"
                            style="padding:22px 40px 28px;"
                        >
                            <a
                                href="{safe_verification_url}"
                                style="
                                    display:inline-block;
                                    padding:15px 28px;
                                    border-radius:10px;
                                    background:#111827;
                                    color:#ffffff;
                                    text-decoration:none;
                                    font-size:16px;
                                    font-weight:700;
                                "
                            >
                                VERIFY MY EMAIL ✨
                            </a>

                            <div
                                style="
                                    margin-top:16px;
                                    font-size:13px;
                                    line-height:1.5;
                                    color:#6b7280;
                                "
                            >
                                This link is valid for 24 hours
                                and can only be used once.
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td
                            align="center"
                            style="
                                padding:0 40px 30px;
                                font-size:15px;
                                line-height:1.6;
                            "
                        >
                            Once you're verified,
                            you're ready to start learning.
                            <br><br>
                            <strong>Learn. Practice. Grow.</strong>
                        </td>
                    </tr>

                    <tr>
                        <td
                            style="
                                padding:24px 40px;
                                background:#f9fafb;
                                font-size:12px;
                                line-height:1.6;
                                color:#6b7280;
                            "
                        >
                            If you didn't create this account,
                            you can safely ignore this email.
                            <br><br>

                            This is an automated message from
                            EasyChatBot.
                            <br><br>

                            <strong>Your privacy matters.</strong>
                            Learn how EasyChatBot handles and protects
                            your personal data:
                            <a
                                href="{safe_privacy_url}"
                                style="
                                    color:#374151;
                                    font-weight:700;
                                "
                            >
                                Data Protection &amp; Privacy
                            </a>
                            <br><br>

                            <strong>EasyChatBot</strong><br>
                            Growing With You.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
"""

    def _build_text(
        self,
        *,
        username: str,
        verification_url: str,
    ) -> str:
        return f"""🎓 Welcome to EasyChatBot

Your journey starts here.

Hey {username} 👋

Welcome to EasyChatBot!

You've just taken your first step into your learning journey —
and we're excited to have you here.

YOUR EASYCHATBOT IDENTITY

@{username}

Your unique identity inside EasyChatBot.

You can use your EasyChatBot alias to connect with other learners,
participate in activities and identify yourself across the platform.

ONE LAST STEP

Before you enter the Academy, let's make sure this email address
really belongs to you.

Verify your email:
{verification_url}

This link is valid for 24 hours and can only be used once.

Once you're verified, you're ready to start learning.

Learn. Practice. Grow.

If you didn't create this account, you can safely ignore this email.

This is an automated message from EasyChatBot.

Your privacy matters.
Learn how EasyChatBot handles and protects your personal data:
{self._privacy_url}

EasyChatBot
Growing With You.
"""
