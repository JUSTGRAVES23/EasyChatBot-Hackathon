from __future__ import annotations

from html import escape

from ..domain.academy_notification import AcademyNotification


class AcademyEmailFormatter:
    """Render the one-week Academy notification as email content."""

    LOGO_CONTENT_ID = "easychatbot-logo"

    def render(
        self,
        notification: AcademyNotification,
    ) -> dict[str, str]:
        username = escape(
            notification.username,
            quote=True,
        )

        portal_url = escape(
            notification.portal_url,
            quote=True,
        )

        html = f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>One Week at EasyChatBot</title>
</head>

<body style="margin:0;padding:0;background:#f7f7f7;font-family:Arial,sans-serif;">
<div style="max-width:620px;margin:0 auto;padding:32px 20px;">
<div style="background:#ffffff;border-radius:16px;padding:32px;">

<div style="text-align:center;margin-bottom:24px;">
<img
    src="cid:{self.LOGO_CONTENT_ID}"
    alt="EasyChatBot"
    style="max-width:220px;height:auto;"
>
</div>

<h1>&#127891; Congratulations, @{username}!</h1>

<p>
It has been one week since you joined the EasyChatBot Academy.
</p>

<p>
What a great start! Every lesson you complete, every question you ask,
and every conversation you have is another step forward in your journey.
</p>

<p>
Keep exploring, keep practising, and keep building your confidence.
Your Academy journey is only just beginning. &#128640;
</p>

<div style="text-align:center;margin:30px 0;">
<a
    href="{portal_url}"
    style="display:inline-block;padding:14px 24px;border-radius:10px;
           text-decoration:none;font-weight:bold;"
>
&#128640; Continue Learning
</a>
</div>

<p>
Keep going, @{username}. We are growing with you.
</p>

<hr>

<p style="font-size:12px;color:#666;">
This is an automated message from EasyChatBot.
</p>

<p style="font-size:12px;color:#666;">
<a href="{portal_url}">Open EasyChatBot</a>
</p>

<p style="font-size:12px;color:#666;text-align:center;">
EasyChatBot &#8212; Growing With You.
</p>

</div>
</div>
</body>
</html>
"""

        text = (
            "\U0001F393"
            f" Congratulations, @{notification.username}!\n\n"
            "It has been one week since you joined the EasyChatBot Academy.\n\n"
            "What a great start! Every lesson you complete, every question "
            "you ask, and every conversation you have is another step "
            "forward in your journey.\n\n"
            "Keep exploring, keep practising, and keep building your "
            "confidence. Your Academy journey is only just beginning. "
            "\U0001F680"
            "\n\n"
            "Continue Learning:\n"
            f"{notification.portal_url}\n\n"
            "This is an automated message from EasyChatBot.\n\n"
            "EasyChatBot \u2014 Growing With You.\n"
        )

        return {
            "html": html,
            "body": text,
        }


class AcademyTelegramFormatter:
    """Render the same notification as Telegram-friendly text."""

    def render(
        self,
        notification: AcademyNotification,
    ) -> str:
        return (
            "\U0001F393"
            f" *Congratulations, @{notification.username}!*\n\n"
            "It has been one week since you joined the "
            "EasyChatBot Academy.\n\n"
            "What a great start! Every lesson you complete, every "
            "question you ask, and every conversation you have is "
            "another step forward in your journey.\n\n"
            "Keep exploring, keep practising, and keep building "
            "your confidence. Your Academy journey is only just "
            "beginning. "
            "\U0001F680"
            "\n\n"
            f"Keep going, @{notification.username}. "
            "We are growing with you."
        )
