@pytest.mark.parametrize(
    "field",
    [
        "transaction_id",
        "principal_id",
        "amount",
        "currency",
        "merchant_or_service",
        "operation",
        "nonce",
    ],
)
def test_every_security_field_changes_canonical_binding(
    transaction: CanonicalTransaction,
    field: str,
) -> None:
    values = {
        "transaction_id": transaction.transaction_id,
        "principal_id": transaction.principal_id,
        "amount": transaction.amount,
        "currency": transaction.currency,
        "merchant_or_service": transaction.merchant_or_service,
        "operation": transaction.operation,
        "timestamp": transaction.timestamp,
        "nonce": transaction.nonce,
        "risk_context": dict(transaction.risk_context),
    }

    replacements = {
        "transaction_id": "txn-changed",
        "principal_id": "user-changed",
        "amount": Decimal("101.00"),
        "currency": "USD",
        "merchant_or_service": "merchant-changed",
        "operation": "refund",
        "nonce": "nonce-changed",
    }

    values[field] = replacements[field]

    changed = CanonicalTransaction.from_mapping(
        transaction_id=values["transaction_id"],
        principal_id=values["principal_id"],
        amount=values["amount"],
        currency=values["currency"],
        merchant_or_service=values["merchant_or_service"],
        operation=values["operation"],
        timestamp=values["timestamp"],
        nonce=values["nonce"],
        risk_context=values["risk_context"],
    )

    assert (
        changed.canonical_representation()
        != transaction.canonical_representation()
    )


