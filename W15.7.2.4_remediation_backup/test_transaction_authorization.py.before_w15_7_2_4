def approved_authorization(
    authorization: TransactionAuthorization,
    clock: FixedClock,
    assurance_level: int = 2,
) -> TransactionAuthorization:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now(),
        evidence_id=f"evidence-{authorization.authorization_id}",
        assurance_level=assurance_level,
    )

    return attach_approval(pending, approval, clock=clock)


