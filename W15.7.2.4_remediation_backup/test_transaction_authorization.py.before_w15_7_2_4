def test_trusted_clock_is_used_for_expiry(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    approved = approved_authorization(authorization, clock)

    clock.current = authorization.expires_at

    expired = expire_if_due(approved, clock=clock)

    assert expired.state is TransactionAuthorizationState.EXPIRED

    result = consume(expired, clock=clock)

    assert result.decision is TransactionAuthorizationDecision.DENY
    assert result.failure is TransactionAuthorizationFailure.EXPIRED


def test_legal_lifecycle_transitions(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approved = approved_authorization(authorization, clock)

    assert pending.state is TransactionAuthorizationState.PENDING_USER_APPROVAL
    assert approved.state is TransactionAuthorizationState.APPROVED


@pytest.mark.parametrize(
    ("old_state", "new_state"),
    [
        (
            TransactionAuthorizationState.CONSUMED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.EXPIRED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.REVOKED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.REJECTED,
            TransactionAuthorizationState.APPROVED,
        ),
    ],
)
def test_illegal_lifecycle_transitions_fail_closed(
    authorization: TransactionAuthorization,
    old_state: TransactionAuthorizationState,
    new_state: TransactionAuthorizationState,
) -> None:
    current = TransactionAuthorization(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        created_at=authorization.created_at,
        expires_at=authorization.expires_at,
        state=old_state,
    )

    with pytest.raises(ValueError):
        transition(current, new_state)


