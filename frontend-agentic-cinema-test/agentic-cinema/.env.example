# Server-side URL for the existing cinema/application backend.
# The browser never receives this value.
CINEMA_BACKEND_URL=http://localhost:8000/your-existing-cinema-endpoint

# Optional action endpoints. If omitted, the UI reports that the action
# is not configured instead of pretending it was persisted.
CINEMA_SAVE_URL=
CINEMA_CHALLENGE_URL=

# Optional bearer token if the backend requires one.
# Keep secrets server-side; do not prefix with NEXT_PUBLIC_.
CINEMA_BACKEND_TOKEN=

# Optional timeout in milliseconds.
CINEMA_BACKEND_TIMEOUT_MS=60000
