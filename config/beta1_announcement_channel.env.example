# Beta 1 Announcement Channel
TELEGRAM_ANNOUNCEMENT_CHANNEL_ENABLED=true

# Classroom bot MUST NOT be a channel administrator.
TELEGRAM_ANNOUNCEMENT_BOT_IS_ADMIN=false

TELEGRAM_ANNOUNCEMENT_USERS_CAN_POST=false
TELEGRAM_ANNOUNCEMENT_USERS_CAN_COMMENT=false
TELEGRAM_ANNOUNCEMENT_REACTIONS_ENABLED=true
TELEGRAM_ANNOUNCEMENT_HISTORY_VISIBLE=true

# No autonomous/scheduled publishing in Beta 1.
TELEGRAM_ANNOUNCEMENT_AUTOMATIC_PUBLISHING=false
TELEGRAM_ANNOUNCEMENT_MEMBERSHIP_VERIFICATION=false

EASYCHATBOT_BETA_APP_URL=https://example.invalid/beta
EASYCHATBOT_BETA_ISSUE_REPORT_URL=https://example.invalid/beta/issues

# Configure only in the infrastructure deployment environment.
# TELEGRAM_ANNOUNCEMENT_CHANNEL_ID=
