def test_approval_must_bind_to_exact_transaction(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    wrong_transaction = CanonicalTransaction.from_mapping(
        transaction_id="txn-002",
        principal_id="user-001",
        amount="100.00",
        currency="EUR",
        merchant_or_service="merchant-001",
        operation="purchase",
        timestamp=authorization.transaction.timestamp,
        nonce="nonce-002",
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=wrong_transaction,
        approved_at=clock.now(),
        evidence_id="evidence-001",
        assurance_level=2,
    )

    with pytest.raises(ValueError):
        attach_approval(
            transition(
                authorization,
                TransactionAuthorizationState.PENDING_USER_APPROVAL,
            ),
            approval,
            clock=clock,
        )


def test_caller_boolean_does_not_create_trusted_approval(
    authorization: TransactionAuthorization,
) -> None:
    assert authorization.approval is None
    assert authorization.state is TransactionAuthorizationState.CREATED


def test_trusted_approval_evidence_is_immutable(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now(),
        evidence_id="evidence-001",
        assurance_level=2,
    )

    approved = attach_approval(
        pending,
        approval,
        clock=clock,
    )

    with pytest.raises(Exception):
        approved.approval.evidence_id = "forged"  # type: ignore[misc]


def test_future_dated_approval_fails_closed(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now() + timedelta(minutes=1),
        evidence_id="evidence-future",
        assurance_level=2,
    )

    with pytest.raises(ValueError):
        attach_approval(
            pending,
            approval,
            clock=clock,
        )


def test_trusted_clock_is_used_for_expiry(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now(),
        evidence_id="evidence-001",
        assurance_level=2,
    )

    approved = attach_approval(
        pending,
        approval,
        clock=clock,
    )

    clock.current = authorization.expires_at

    result = consume(approved, clock=clock)

    assert result.decision is TransactionAuthorizationDecision.DENY
    assert result.failure is TransactionAuthorizationFailure.EXPIRED


def test_legal_lifecycle_transitions(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now(),
        evidence_id="evidence-001",
        assurance_level=2,
    )

    approved = attach_approval(
        pending,
        approval,
        clock=clock,
    )

    consumed = mark_consumed(approved)

    assert consumed.state is TransactionAuthorizationState.CONSUMED


@pytest.mark.parametrize(
    ("old_state", "new_state"),
    [
        (
            TransactionAuthorizationState.CONSUMED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.EXPIRED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.REVOKED,
            TransactionAuthorizationState.APPROVED,
        ),
        (
            TransactionAuthorizationState.REJECTED,
            TransactionAuthorizationState.APPROVED,
        ),
    ],
)
def test_illegal_lifecycle_transitions_fail_closed(
    authorization: TransactionAuthorization,
    old_state: TransactionAuthorizationState,
    new_state: TransactionAuthorizationState,
) -> None:
    current = TransactionAuthorization(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        created_at=authorization.created_at,
        expires_at=authorization.expires_at,
        state=old_state,
    )

    with pytest.raises(ValueError):
        transition(current, new_state)


def test_unapproved_transaction_denies(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    result = consume(authorization, clock=clock)

    assert result.decision is TransactionAuthorizationDecision.DENY
    assert result.failure is TransactionAuthorizationFailure.INVALID_APPROVAL


def test_consumed_transaction_denies_replay(
    authorization: TransactionAuthorization,
    clock: FixedClock,
) -> None:
    pending = transition(
        authorization,
        TransactionAuthorizationState.PENDING_USER_APPROVAL,
    )

    approval = TrustedApprovalEvidence(
        authorization_id=authorization.authorization_id,
        transaction=authorization.transaction,
        approved_at=clock.now(),
        evidence_id="evidence-001",
        assurance_level=2,
    )

    approved = attach_approval(
        pending,
        approval,
        clock=clock,
    )

    consumed = mark_consumed(approved)

    result = consume(consumed, clock=clock)

    assert result.decision is TransactionAuthorizationDecision.DENY
    assert result.failure is TransactionAuthorizationFailure.ALREADY_CONSUMED


