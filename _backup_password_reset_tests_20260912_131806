from __future__ import annotations

from unittest.mock import AsyncMock
from uuid import UUID

import pytest

from app.application.identity.authentication_service import (
    AuthenticationError,
    AuthenticationService,
)


class FakeAuthenticationRepository:
    """Minimal repository contract required by registration."""

    def __init__(self) -> None:
        self.created_user = None
        self.created_password = None
        self.created_verification = None
        self.email_verified = False

    async def email_exists(self, email: str) -> bool:
        return False

    async def username_exists(self, username: str) -> bool:
        return False

    async def create_user(
        self,
        *,
        user_id: UUID,
        email: str,
        username: str,
    ) -> UUID:
        self.created_user = {
            "user_id": user_id,
            "email": email,
            "username": username,
        }
        return user_id

    async def create_password_credential(
        self,
        *,
        user_id: UUID,
        password_hash: str,
    ) -> None:
        self.created_password = {
            "user_id": user_id,
            "password_hash": password_hash,
        }

    async def create_email_verification(
        self,
        *,
        user_id: UUID,
        email: str,
    ) -> str:
        self.created_verification = {
            "user_id": user_id,
            "email": email,
        }
        return "raw-verification-token"


class FakePasswordHasher:
    def hash(self, password: str) -> str:
        return f"hashed:{password}"


@pytest.mark.asyncio
async def test_register_creates_unverified_user_and_sends_verification_email():
    repository = FakeAuthenticationRepository()
    email_service = AsyncMock()

    service = AuthenticationService(
        repository,
        email_service=email_service,
        password_hasher=FakePasswordHasher(),
    )

    user_id = await service.register(
        email=" USER@example.com ",
        username=" testuser ",
        password="Strong-password-123!",
    )

    assert isinstance(user_id, UUID)

    assert repository.created_user == {
        "user_id": user_id,
        "email": "user@example.com",
        "username": "testuser",
    }

    assert repository.created_password == {
        "user_id": user_id,
        "password_hash": "hashed:Strong-password-123!",
    }

    assert repository.created_verification == {
        "user_id": user_id,
        "email": "user@example.com",
    }

    assert repository.email_verified is False

    email_service.send_verification_email.assert_awaited_once_with(
        email="user@example.com",
        username="testuser",
        verification_token="raw-verification-token",
    )


@pytest.mark.asyncio
async def test_register_requires_email_delivery_configuration():
    repository = FakeAuthenticationRepository()

    service = AuthenticationService(
        repository,
        email_service=None,
        password_hasher=FakePasswordHasher(),
    )

    with pytest.raises(
        AuthenticationError,
        match="Registration email delivery is not configured",
    ):
        await service.register(
            email="user@example.com",
            username="testuser",
            password="Strong-password-123!",
        )

    assert repository.created_user is not None
    assert isinstance(repository.created_user["user_id"], UUID)

    assert repository.created_verification == {
        "user_id": repository.created_user["user_id"],
        "email": "user@example.com",
    }

    assert repository.email_verified is False


@pytest.mark.asyncio
async def test_register_keeps_user_unverified_when_email_delivery_fails():
    repository = FakeAuthenticationRepository()

    email_service = AsyncMock()
    email_service.send_verification_email.side_effect = RuntimeError(
        "provider unavailable"
    )

    service = AuthenticationService(
        repository,
        email_service=email_service,
        password_hasher=FakePasswordHasher(),
    )

    with pytest.raises(
        AuthenticationError,
        match="Registration email could not be sent",
    ):
        await service.register(
            email="user@example.com",
            username="testuser",
            password="Strong-password-123!",
        )

    email_service.send_verification_email.assert_awaited_once_with(
        email="user@example.com",
        username="testuser",
        verification_token="raw-verification-token",
    )

    assert repository.created_user is not None
    assert repository.email_verified is False


@pytest.mark.asyncio
async def test_register_does_not_expose_verification_token_on_delivery_failure():
    repository = FakeAuthenticationRepository()

    email_service = AsyncMock()
    email_service.send_verification_email.side_effect = RuntimeError(
        "provider unavailable"
    )

    service = AuthenticationService(
        repository,
        email_service=email_service,
        password_hasher=FakePasswordHasher(),
    )

    with pytest.raises(AuthenticationError) as exc_info:
        await service.register(
            email="user@example.com",
            username="testuser",
            password="Strong-password-123!",
        )

    assert "raw-verification-token" not in str(exc_info.value)
    assert repository.email_verified is False


@pytest.mark.asyncio
async def test_register_does_not_report_success_when_email_delivery_fails():
    repository = FakeAuthenticationRepository()

    email_service = AsyncMock()
    email_service.send_verification_email.side_effect = RuntimeError(
        "provider unavailable"
    )

    service = AuthenticationService(
        repository,
        email_service=email_service,
        password_hasher=FakePasswordHasher(),
    )

    with pytest.raises(
        AuthenticationError,
        match="Registration email could not be sent",
    ):
        await service.register(
            email="user@example.com",
            username="testuser",
            password="Strong-password-123!",
        )

    assert repository.created_user is not None
    assert repository.email_verified is False

    email_service.send_verification_email.assert_awaited_once()