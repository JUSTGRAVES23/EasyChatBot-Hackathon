# LLM Provider
EASYCHATBOT_LLM_PROVIDER=openai


# Model
EASYCHATBOT_LLM_MODEL=gpt-5-mini


# API Keys
# Configure locally only

OPENAI_API_KEY=
GEMINI_API_KEY=
PARALLEL_API_KEY=