{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🧪 Run Unit Tests",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "showReuseMessage": true
            },
            "problemMatcher": []
        },
        {
            "label": "🔍 Run Failing Test Debug Preparation",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pytest",
                "${file}",
                "-v",
                "-s"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🚀 Start EasyChatBot API",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "uvicorn",
                "backend.main:app",
                "--reload"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🧹 Clean Python Cache",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Get-ChildItem -Recurse -Directory -Filter __pycache__ | Remove-Item -Recurse -Force"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "✅ EasyChatBot Validation",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pytest",
                "-q"
            ],
            "dependsOn": [
                "Clean Python Cache"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}