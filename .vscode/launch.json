{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐞 Debug Current Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "🚀 Debug EasyChatBot API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--reload"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}